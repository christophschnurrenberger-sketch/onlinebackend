# --- Server -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Öffentliche Basis-URL des Shops. Wird für Links in E-Mails, Redirects und
# Zahlungsanbieter-Rückleitungen benutzt.
BASE_URL=http://localhost:3000

# --- Datenbank --------------------------------------------------------------
DATABASE_FILE=./data/shop.db

# --- Sicherheit -------------------------------------------------------------
# Zufälliger Wert, signiert Session-Cookies. In Produktion zwingend setzen:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Erster Admin-Benutzer, wird beim Seed angelegt.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# --- Zahlungen --------------------------------------------------------------
# Aktive Anbieter, kommagetrennt: mock,stripe,paypal,invoice,prepayment,cod
PAYMENT_PROVIDERS=mock,invoice,prepayment

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# --- Statischer Export ------------------------------------------------------
# Zielordner für "npm run export" (statische Website-Dateien).
EXPORT_DIR=./dist
