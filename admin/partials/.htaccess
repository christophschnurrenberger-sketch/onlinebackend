# Kein Zugriff über den Browser. Das Shop-System liest diese Dateien intern
# (per include) – davon ist diese Sperre nicht betroffen.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  <IfModule mod_authz_host.c>
    Order allow,deny
    Deny from all
  </IfModule>
</IfModule>
